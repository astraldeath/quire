{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local library access for the application window; no remote origins.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "sql:allow-load", "sql:allow-select", "sql:allow-execute",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://mangabaka.org/*" },
      { "url": "https://en.wiktionary.org/*" }
    ] }
  ]
}
